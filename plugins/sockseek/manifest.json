{
  "manifest_version": 1,
  "protocol_version": 1,
  "id": "sockseek",
  "version": "1.0.13",
  "architectures": [
    "amd64"
  ],
  "server_versions": [
    "1.0.0",
    "1.0.1",
    "2.0.4",
    "2.0.5",
    "2.0.6",
    "2.0.7",
    "2.0.8"
  ],
  "capabilities": ["search", "fetch", "share"],
  "sources": {
    "search": [
      "soulseek"
    ],
    "fetch": [
      "soulseek"
    ]
  },
  "settings": [
    {
      "key": "username",
      "label": "Download account name",
      "type": "text",
      "required": true
    },
    {
      "key": "password",
      "label": "Download account password",
      "type": "secret",
      "required": true
    },
    {
      "key": "share_username",
      "label": "Sharing account name",
      "type": "text",
      "required": false
    },
    {
      "key": "share_password",
      "label": "Sharing account password",
      "type": "secret",
      "required": false
    }
  ]
}
